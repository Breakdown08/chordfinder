; Engine configuration file.
config_version=5

[application]

config/name="Chord Finder"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[audio]

driver/enable_input=true

[debug]

; Every variable, parameter and return value carries an explicit type (Kirill's rule): untyped and
; inferred (:=) declarations are errors, so the script does not load.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
